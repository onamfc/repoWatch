{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repowatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  // Non-secret configuration. Secrets (SLACK_WEBHOOK_URL, GITHUB_WEBHOOK_SECRET)
  // are set with `wrangler secret put` and never live in this file.
  "vars": {
    // Which pull_request actions produce a Slack message.
    // Useful values: opened, reopened, ready_for_review, closed, synchronize.
    "PR_ACTIONS": "opened,reopened,ready_for_review",
    // When "false", draft PRs are silent until they are marked ready for review.
    "NOTIFY_DRAFTS": "false",
    // Comma-separated GitHub logins whose PRs are ignored (e.g. your own, or bots).
    "IGNORED_AUTHORS": "",
    // Which repositories to watch. Empty = every repo the GitHub App is installed on.
    // Entries are "owner/repo" or "owner/*". Matching is case-insensitive.
    "WATCHED_REPOS": [
      "onamfc/52-for-52",
      "onamfc/laravel-devlogger",
      "onamfc/gravity-forms-clevertap-integration",
      "onamfc/laravel-database-archiver",
      "onamfc/laravel-route-visualizer",
      "onamfc/eloquent-to-json-generator",
      "onamfc/mcp-starter-template-ts",
      "onamfc/video-transcoder",
      "onamfc/github-non-follow-backs",
      "onamfc/api-mocker",
      "onamfc/developer-log",
      "onamfc/github-follow-back",
      "onamfc/package-analyzer",
      "onamfc/npm-vulnerability-scanner",
      "onamfc/vibe-coder-prompt-builder",
      "onamfc/rag-chat",
      "onamfc/mcp-github-integration",
      "onamfc/agent-prompt-library",
      "onamfc/security-scanner",
      "onamfc/cheesebox",
      "onamfc/img-optimize",
      "onamfc/case-shift",
      "onamfc/waypointjs",
      "onamfc/stadium-lights",
      "onamfc/branch-clean",
      "onamfc/magic-calculator",
      "onamfc/gavel",
      "onamfc/disc-drive",
      "onamfc/drizzle-soft-delete",
      "onamfc/runner-404",
      "onamfc/exitramp",
      "onamfc/linear-archive",
      "LinkForty/core",
      "LinkForty/mobile-sdk-react-native",
      "LinkForty/mobile-sdk-ios",
      "LinkForty/mobile-sdk-android",
      "LinkForty/mobile-sdk-expo",
      "LinkForty/fliq",
      "LinkForty/mcp-server",
      "LinkForty/aasa-validator",
      "LinkForty/og-preview",
      "xantus-ai/Fleet",
      "xantus-ai/wp-llms-plugin",
      "xantus-ai/spec-seal"
    ]
  }
}
