{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repowatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  // Non-secret configuration. Secrets (SLACK_WEBHOOK_URL, GITHUB_WEBHOOK_SECRET)
  // are set with `wrangler secret put` and never live in this file.
  "vars": {
    // Which pull_request actions produce a Slack message.
    // Useful values: opened, reopened, ready_for_review, closed, synchronize.
    "PR_ACTIONS": "opened,reopened,ready_for_review",
    // When "false", draft PRs are silent until they are marked ready for review.
    "NOTIFY_DRAFTS": "false",
    // Comma-separated GitHub logins whose PRs are ignored (e.g. your own, or bots).
    "IGNORED_AUTHORS": "",
    // Which repositories to watch, as "owner/repo" or "owner/*" (case-insensitive).
    // Unset or empty = every repo the GitHub App is installed on.
    //
    // Either list them here, or keep the list out of version control by setting
    // it as a secret instead (comma- or newline-separated):
    //   npx wrangler secret put WATCHED_REPOS < watched-repos.txt
    // Do not do both -- a var and a secret cannot share a name.
    //
    // "WATCHED_REPOS": ["acme/widgets", "acme-labs/*"]
  }
}
